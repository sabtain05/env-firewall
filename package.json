{
  "name": "env-firewall",
  "version": "1.0.0",
  "description": "Zero-dependency runtime environment variable parser, type-caster, and boot-time firewall.",
  "main": "./dist/cjs/src/index.js",
  "module": "./dist/esm/src/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/esm/src/index.js",
      "require": "./dist/cjs/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist/types",
    "build:esm": "tsc --module esnext --moduleResolution bundler --outDir dist/esm && node -e \"require('node:fs').writeFileSync('dist/esm/package.json', JSON.stringify({ type: 'module' }))\"",
    "build:cjs": "tsc --module commonjs --moduleResolution node --outDir dist/cjs",
    "build": "npm run clean && npm run build:types && npm run build:esm && npm run build:cjs",
    "test": "npm run build && node --test \"dist/cjs/tests/**/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "env",
    "dotenv",
    "environment",
    "validation",
    "typescript",
    "zero-dependency",
    "config"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}